{
  "id": "/",
  "name": "Finanzas Claras",
  "short_name": "Finanzas Claras",
  "description": "Organiza tus ingresos, gastos y tickets.",
  "lang": "es-MX",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f7f4",
  "theme_color": "#f5f7f4",
  "icons": [
    { "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share-ticket",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "ticket", "accept": ["image/jpeg", "image/png", "application/pdf", ".jpg", ".jpeg", ".png", ".pdf"] }
      ]
    }
  }
}
